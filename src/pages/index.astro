  { src: "/logos/cliente-02.svg", alt: "Cliente 02" },
  { src: "/logos/cliente-03.svg", alt: "Cliente 03" },
  { src: "/logos/cliente-04.svg", alt: "Cliente 04" },
  { src: "/logos/cliente-05.svg", alt: "Cliente 05" },
  { src: "/logos/cliente-06.svg", alt: "Cliente 06" },
  { src: "/logos/cliente-07.svg", alt: "Cliente 07" },
  { src: "/logos/cliente-08.svg", alt: "Cliente 08" },
  { src: "/logos/cliente-09.svg", alt: "Cliente 09" },
  { src: "/logos/cliente-10.svg", alt: "Cliente 10" },
  { src: "/logos/cliente-11.svg", alt: "Cliente 11" },
  { src: "/logos/cliente-12.svg", alt: "Cliente 12" },
  { src: "/logos/cliente-13.svg", alt: "Cliente 13" },
