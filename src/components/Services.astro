---
import SectionTitle from './SectionTitle.astro';
import { servicios } from '../data/services.js';

const palettes = [
  { bg: 'from-emerald-50 to-emerald-100', text: 'text-emerald-900' },
  { bg: 'from-sky-50 to-sky-100', text: 'text-sky-900' },
  { bg: 'from-amber-50 to-amber-100', text: 'text-amber-900' },
  { bg: 'from-rose-50 to-rose-100', text: 'text-rose-900' },
  { bg: 'from-indigo-50 to-indigo-100', text: 'text-indigo-900' },
  { bg: 'from-lime-50 to-lime-100', text: 'text-lime-900' },
];
---

<section id="servicios" class="py-20 scroll-mt-20">
  <div class="container relative">
    <SectionTitle 
      title="Servicios" 
      subtitle="Soluciones para hogar, comercio e industria" 
    />
  </div>

  <!-- Cards apiladas -->
  <div class="relative mx-auto w-full max-w-5xl px-4 sm:px-6 space-y-6">
    {servicios.map((s, i) => {
      const pal = palettes[i % palettes.length];
      const z = 10 + i;

      return (
        <article
          class={`sticky top-32 bg-gradient-to-br ${pal.bg} ${pal.text} rounded-2xl w-full mx-auto overflow-hidden`}
          style={`z-index:${z};`}
        >
          <div class="flex flex-col md:flex-row">
            <!-- Texto -->
            <div class="flex-1 p-6 md:p-8">
              <h3 class="text-2xl font-bold tracking-tight">{s.title}</h3>
              {Array.isArray(s.desc) ? (
                <ul class="mt-3 list-disc list-inside space-y-2 text-base leading-relaxed">
                  {s.desc.map((step) => <li>{step}</li>)}
                </ul>
              ) : (
                <p class="mt-3 text-base leading-relaxed">{s.desc}</p>
              )}
            </div>

            <!-- Imagen -->
            <div class="md:w-1/2">
              <img
                src={s.img}
                alt={s.title}
                loading="lazy"
                class="w-full h-64 md:h-full object-cover"
              />
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
