---
import SectionTitle from './SectionTitle.astro';
import { servicios } from '../data/services.js';
---

<section id="servicios" class="py-20 scroll-mt-20">
  <div class="container">
    <SectionTitle 
      title="Servicios" 
      subtitle="Soluciones para hogar, comercio e industria" 
    />

    <!-- Grid responsive con animación escalonada -->
    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.map((s, i) => (
        <article 
          class="group relative flex flex-col rounded-2xl bg-white shadow-md overflow-hidden transform transition duration-300 hover:-translate-y-2 hover:shadow-xl"
          style={{ animationDelay: `${i * 100}ms` }}
        >
          <!-- Imagen -->
          <div class="relative h-56 w-full overflow-hidden">
            <img 
              src={s.imgCard} 
              alt={`Servicio de ${s.title}`} 
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />

            <!-- Overlay hover -->
            <div class="absolute inset-0 flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity">
              <button 
                type="button"
                class="open-service-modal inline-flex items-center gap-2 rounded-full px-5 py-2 bg-emerald-600 text-white font-medium shadow-lg hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition"
                data-index={i}
                aria-label={`Ver más sobre ${s.title}`}
              >
                Ver más
              </button>
            </div>
          </div>

          <!-- Contenido -->
          <div class="flex-1 p-6 flex flex-col">
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition">
              {s.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600 line-clamp-3">
              {typeof s.desc === "string" ? s.desc : ""}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>

  
  <!-- Modal -->

<div 
  id="service-modal" 
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="service-modal-title"
  tabindex="-1"
>
  <!-- Backdrop -->
  <div 
    id="service-modal-backdrop"
    class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Dialog -->
  <div 
    id="service-modal-dialog"
    class="relative bg-white rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl 
           transform transition-all duration-300 ease-in-out 
           opacity-0 scale-95"
    role="document"
  >
    <!-- Botón cerrar -->
    <button
      id="service-modal-close"
      type="button"
      class="absolute top-4 right-4 z-20 inline-flex items-center justify-center w-10 h-10 
         rounded-full bg-white/60 backdrop-blur-sm text-slate-600 
         hover:bg-emerald-600 hover:text-white 
         focus:outline-none focus:ring-2 focus:ring-emerald-500 
         transition"
      aria-label="Cerrar modal"
    >
    <!-- Heroicon X -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
      <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
    </svg>
    </button>


    <!-- Imagen + botones navegación -->
    <div class="relative h-64 sm:h-80">
      <img 
        id="service-modal-img" 
        src="" 
        alt="" 
        class="w-full h-full object-cover" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      <h2 
        id="service-modal-title" 
        class="absolute bottom-4 left-6 text-2xl sm:text-3xl font-bold text-white drop-shadow-lg"
      ></h2>

      <!-- Botón anterior -->
      <button 
        id="service-modal-prev"
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 z-20 flex items-center justify-center 
          w-10 h-10 sm:w-12 sm:h-12 rounded-full 
          bg-white/60 backdrop-blur-sm text-slate-700 
           hover:bg-emerald-600 hover:text-white 
          focus:outline-none focus:ring-2 focus:ring-emerald-500 
          transition"
        aria-label="Servicio anterior"
>
      <!-- Heroicon: chevron-left -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
        <path fill-rule="evenodd" d="M4.72 9.47a.75.75 0 0 0 0 1.06l4.25 4.25a.75.75 0 1 0 1.06-1.06L6.31 10l3.72-3.72a.75.75 0 1 0-1.06-1.06L4.72 9.47Zm9.25-4.25L9.72 9.47a.75.75 0 0 0 0 1.06l4.25 4.25a.75.75 0 1 0 1.06-1.06L11.31 10l3.72-3.72a.75.75 0 0 0-1.06-1.06Z" clip-rule="evenodd" />
      </svg>

      </button>


      <!-- Botón siguiente -->
      <button 
        id="service-modal-next"
        type="button"
        class="absolute right-3 top-1/2 -translate-y-1/2 z-20 flex items-center justify-center 
           w-10 h-10 sm:w-12 sm:h-12 rounded-full 
           bg-white/60 backdrop-blur-sm text-slate-700 
           hover:bg-emerald-600 hover:text-white 
          focus:outline-none focus:ring-2 focus:ring-emerald-500 
          transition"
        aria-label="Servicio siguiente"
      >
  <!-- Heroicon: chevron-right -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
        <path fill-rule="evenodd" d="M15.28 9.47a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L13.69 10 9.97 6.28a.75.75 0 0 1 1.06-1.06l4.25 4.25ZM6.03 5.22l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L8.69 10 4.97 6.28a.75.75 0 0 1 1.06-1.06Z" clip-rule="evenodd" />
      </svg>

      </button>

    </div>

    <!-- Contenido -->
    <div class="p-6">
      <div 
        id="service-modal-desc" 
        class="text-slate-700 leading-relaxed text-base sm:text-lg"
      ></div>

      <!-- CTA opcional -->
      <div class="mt-6 flex justify-end">
        <a 
          href="#contacto" 
          class="inline-flex items-center gap-2 px-5 py-2 rounded-lg bg-emerald-600 text-white font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          Solicitar servicio
        </a>
      </div>
    </div>
  </div>
</div>




  <!-- Cargamos script modular -->
  <script type="module">
    import { initServicesModal } from "/src/scripts/servicesModal.js";
    initServicesModal();
  </script>
</section>
