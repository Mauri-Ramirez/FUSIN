---
/**
 * Componente SectionTitle.astro
 * Un título reutilizable para secciones.
 * Props:
 *  - title: string (texto principal)
 *  - subtitle?: string (texto secundario opcional)
 *  - align?: "center" | "left" (alineación del texto, por defecto "center")
 */
const { title, subtitle, align = "center" } = Astro.props;
---

<div class={`mx-auto mb-10 max-w-2xl text-${align}`}>
  <h2 class="text-3xl font-semibold">{title}</h2>
  {subtitle && <p class="mt-3 text-slate-600">{subtitle}</p>}
</div>
