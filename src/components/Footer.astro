---
const year = new Date().getFullYear();
const wa = "https://wa.me/573000000000?text=Hola%20FUSIN,%20quiero%20una%20cotización";
---
<footer id="contacto" class="border-t bg-white/80 py-12">
  <div class="container grid gap-10 md:grid-cols-5">
    
    <!-- Marca -->
    <div>
      <h4 class="text-lg font-semibold text-emerald-700">FUSIN</h4>
      <p class="mt-3 text-sm text-slate-600">
        Fumigaciones y Soluciones Integrales. Atención en toda la ciudad y alrededores.
      </p>
    </div>

    <!-- Navegación -->
    <div>
      <h4 class="text-lg font-semibold text-emerald-700">Secciones</h4>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a class="hover:text-emerald-700" href="#inicio">Inicio</a></li>
        <li><a class="hover:text-emerald-700" href="#servicios">Servicios</a></li>
        <li><a class="hover:text-emerald-700" href="#clientes">Clientes</a></li>
        <li><a class="hover:text-emerald-700" href="#contacto">Contacto</a></li>
      </ul>
    </div>

    <!-- Contacto -->
    <div>
      <h4 class="text-lg font-semibold text-emerald-700">Contacto</h4>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li class="flex items-center gap-2">
          📱 <a class="underline hover:text-emerald-700" href={wa} target="_blank" rel="noopener">WhatsApp</a>
        </li>
        <li class="flex items-center gap-2">
          ☎️ <a class="underline hover:text-emerald-700" href="tel:+573000000000">+57 300 000 0000</a>
        </li>
        <li class="flex items-center gap-2">
          ✉️ <a class="underline hover:text-emerald-700" href="mailto:hola@fusin.com">hola@fusin.com</a>
        </li>
      </ul>
    </div>

    <!-- Cobertura -->
    <div>
      <h4 class="text-lg font-semibold text-emerald-700">Cobertura</h4>
      <p class="mt-3 text-sm text-slate-600">Residencial, comercial e industrial.</p>
    </div>

    <!-- Mapa con iframe -->
    <div>
      <h4 class="text-lg font-semibold text-emerald-700">Ubicación</h4>
      <div class="mt-3 rounded-xl overflow-hidden border shadow-sm">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3972.4744803480417!2d-72.39269112432292!3d5.344303935740703!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e6b0c529c2c4139%3A0x51a106b3260ce563!2sCl.%2018%20%2327-33%2C%20Yopal%2C%20Casanare!5e0!3m2!1ses-419!2sco!4v1756702410426!5m2!1ses-419!2sco"
          width="100%"
          height="180"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>

  <!-- Derechos -->
  <div class="container mt-10 text-center text-xs text-slate-500">
    © {year} FUSIN. Todos los derechos reservados.
  </div>
</footer>
