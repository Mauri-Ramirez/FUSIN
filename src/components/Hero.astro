    <div class="flex flex-wrap justify-center gap-3 pt-4 text-sm">
      <span class="badge bg-white/20 text-white border-white/30">Garantía escrita</span>
      <span class="badge bg-white/20 text-white border-white/30">Productos certificados</span>
      <span class="badge bg-white/20 text-white border-white/30">Atención 24/7</span>
