---
const wa = 'https://wa.me/573000000000?text=Hola%20FUSIN,%20quiero%20una%20cotizaci%C3%B3n';
const phone = '+57 300 000 0000';
---
<section
  class="relative overflow-hidden h-screen flex items-center justify-center text-center"
  style="background-image: url('/images/hero-bg.jpg'); background-size: cover; background-position: center;"
>
  <!-- Overlay oscuro encima de la imagen -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Contenido -->
  <div class="relative z-10 max-w-3xl px-6 text-white space-y-6">
    <h1 class="text-4xl font-bold leading-tight md:text-6xl">
      Fumigaciones y Soluciones Integrales
    </h1>
    <p class="text-lg md:text-xl text-gray-200">
      Control de plagas profesional para hogares y empresas. Respuesta rápida,
      garantía de servicio y productos certificados.
    </p>

    <div class="flex justify-center">
  <a 
    href={wa} 
    target="_blank" 
    rel="noopener" 
    class="btn btn-primary flex items-center gap-2"
  >
