---
/**
 * EvidenceCarousel.astro (versión con barra tipo Instagram usando scaleX)
 * 
 * Props:
 *  images: Array<{ src: string; alt: string }>
 * 
 * - Autoplay cada 4s.
 * - Botones prev/next.
 * - Barra de progreso minimalista responsive (Tailwind).
 * - Uso de transform: scaleX para mejor rendimiento (GPU).
 */
const { images = [] } = Astro.props;
---

<section id="evidencias" class="py-16">
  <div class="container">
    <!-- Título -->
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-3xl font-semibold">Evidencias de trabajos</h2>
      <p class="mt-3 text-slate-600">Antes / después y registros fotográficos reales.</p>
    </div>

    <div class="relative">
      <!-- Botones -->
      <button type="button" aria-label="Anterior" data-action="prev"
        class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full border bg-white/80 px-3 py-2 shadow hover:bg-white">
        ‹
      </button>
      <button type="button" aria-label="Siguiente" data-action="next"
        class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full border bg-white/80 px-3 py-2 shadow hover:bg-white">
        ›
      </button>

      <!-- Viewport -->
      <div id="evidencias-viewport" data-viewport tabindex="0" role="region" aria-label="Carrusel de evidencias"
        class="no-scrollbar overflow-x-auto scroll-smooth snap-x snap-mandatory">
        <ul class="flex gap-4 p-1">
          {images.map((img) => (
            <li class="snap-center shrink-0 w-[85%] md:w-[60%] lg:w-[45%]">
              <figure class="overflow-hidden rounded-3xl border bg-white/70 shadow-soft">
                <img src={img.src} alt={img.alt} class="h-[360px] w-full object-cover" loading="lazy" />
              </figure>
            </li>
          ))}
        </ul>
      </div>

      <!-- Barra de progreso -->
      <div id="evi-progress" class="mt-6 flex justify-center gap-2"></div>
    </div>
  </div>
</section>

<!-- Script -->
<script is:inline>
(() => {
  const ROOT_ID = 'evidencias';
  const AUTOPLAY_MS = 4000; // tiempo entre slides
  const root = document.getElementById(ROOT_ID);
  if (!root) return;

  const vp = root.querySelector('[data-viewport]');
  const prev = root.querySelector('[data-action="prev"]');
  const next = root.querySelector('[data-action="next"]');
  const progressContainer = root.querySelector('#evi-progress');

  if (!vp) return;
  const items = vp.querySelectorAll('li');
  if (!items.length) return;

  // Crear barras dinámicas
  progressContainer.innerHTML = items.length > 1
    ? [...items].map((_, i) =>
      `<div class="relative h-1 w-12 overflow-hidden rounded bg-gray-300">
         <div data-bar="${i}" class="absolute left-0 top-0 h-full w-full origin-left scale-x-0 bg-blue-500"></div>
       </div>`
    ).join('')
    : '';

  const bars = progressContainer.querySelectorAll('[data-bar]');
  let activeIndex = 0;
  let timer;

  // Actualizar barra activa con scaleX
  const updateBars = (index) => {
    bars.forEach((bar, i) => {
      bar.style.transition = "none";
      bar.style.transform = "scaleX(0)";

      if (i === index) {
        // Forzar reflow para reiniciar animación
        bar.getBoundingClientRect();
        bar.style.transition = `transform ${AUTOPLAY_MS}ms linear`;
        bar.style.transform = "scaleX(1)";
      }
    });
  };

  // Funciones de navegación
  const goTo = (index) => {
    if (index < 0) index = items.length - 1;
    if (index >= items.length) index = 0;
    vp.scrollTo({ left: items[index].offsetLeft, behavior: 'smooth' });
    activeIndex = index;
    updateBars(activeIndex);
  };

  const goNext = () => goTo(activeIndex + 1);
  const goPrev = () => goTo(activeIndex - 1);

  prev?.addEventListener('click', goPrev);
  next?.addEventListener('click', goNext);

  // Autoplay
  const start = () => {
    stop();
    if (items.length > 1) {
      updateBars(activeIndex);
      timer = setInterval(goNext, AUTOPLAY_MS);
    }
  };
  const stop = () => {
    if (timer) clearInterval(timer);
  };

  vp.addEventListener('pointerenter', stop);
  vp.addEventListener('pointerleave', start);

  // Inicializar
  updateBars(activeIndex);
  start();
})();
</script>
