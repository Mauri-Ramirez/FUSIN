---
/**
 * ClientsCarousel.astro
 */
const { logos = [] } = Astro.props;

// duplicamos para el loop infinito
const track = [...logos, ...logos];

// calculamos duración dinámicamente: 3s por logo
const durationPerLogo = 3;
const animationDuration = `${logos.length * durationPerLogo}s`;
---

<section id="clientes" class="py-16">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center mb-10">
      <h2 class="text-3xl font-semibold">Empresas que confían en FUSIN</h2>
      <p class="mt-3 text-slate-600">Sectores residencial, comercial e industrial.</p>
    </div>

    <div class="relative overflow-hidden rounded-2xl border bg-white/70 p-6 shadow-soft">
      <ul
        class="marquee-track"
        style={`--marquee-duration: ${animationDuration};`}
      >
        {track.map((logo, i) => (
          <li class="logo-item" aria-hidden={i >= logos.length ? 'true' : 'false'}>
            <img
              src={logo.src}
              alt={logo.alt}
              class="h-10 w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
:root {
  --marquee-gap: 3rem;
}

.marquee-track {
  display: flex;
  align-items: center;
  gap: var(--marquee-gap);
  width: max-content;
  animation: marquee var(--marquee-duration, 25s) linear infinite;
}
.marquee-track:hover {
  animation-play-state: paused;
}

.logo-item {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* Animación infinita */
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>
