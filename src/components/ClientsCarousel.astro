---
/**
 * ClientsGlassOptimized.astro
 */
import SectionTitle from "./SectionTitle.astro";
const { logos = [] } = Astro.props;
---

<section id="clientes" class="relative py-16 bg-gray-50">
  <!-- Fondo sutil -->
  <div class="absolute inset-0 bg-[url('/images/pattern.png')] bg-cover opacity-5"></div>

  <div class="relative container mx-auto px-6 lg:px-12">
    <SectionTitle
      title="Nuestros Clientes"
      subtitle="Empresas que avalan nuestra calidad"
    />

    <!-- Contenedor flexible -->
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      {logos.map((logo) => (
        <a
          href={logo.link ?? "#"}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center transition-transform hover:scale-110"
        >
          <img
            src={logo.src}
            alt={logo.alt}
            class="h-12 sm:h-14 w-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  </div>
</section>
