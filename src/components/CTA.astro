---
const wa = 'https://wa.me/573000000000?text=Hola%20FUSIN,%20quiero%20una%20cotización';
---

<section class="py-16">
  <div class="container">
    <div class="rounded-3xl bg-gradient-to-r from-emerald-600 to-emerald-700 px-8 py-14 text-center text-white shadow-soft">
      <h3 class="text-3xl md:text-4xl font-bold">Agenda tu servicio hoy mismo</h3>
      <p class="mt-3 text-lg opacity-90">Respuesta rápida y garantía escrita en todos nuestros trabajos.</p>
      
      <!-- Botón CTA -->
      <div class="mt-8 flex justify-center">
        <a 
          href={wa} 
          target="_blank" 
          rel="noopener" 
          aria-label="Cotizar por WhatsApp"
          class="flex items-center gap-3 rounded-xl bg-white px-6 py-3 text-lg font-medium text-emerald-700 shadow-md transition hover:scale-105 hover:shadow-lg active:scale-95 w-full md:w-auto justify-center"
        >
          <!-- Icono WhatsApp -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.19 2 11.5c0 1.87.58 3.6 1.57 5.07L2 22l5.65-1.5A10.43 10.43 0 0 0 12 21c5.523 0 10-4.19 10-9.5S17.523 2 12 2Z"/>
          </svg>
          Cotizar por WhatsApp
        </a>
      </div>

      <!-- Confianza -->
      <p class="mt-4 text-sm opacity-80">Atención inmediata — Sin compromiso</p>
    </div>
  </div>
</section>
