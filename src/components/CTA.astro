      <p class="mt-3 text-lg opacity-90">Te brindamos atención inmediata y garantía en cada servicio.</p>

      <!-- Botón CTA -->
      <div class="mt-8 flex justify-center">
        <a 
          href={wa} 
          target="_blank" 
          rel="noopener"
          class="flex items-center gap-3 rounded-xl bg-white px-6 py-3 text-lg font-medium text-emerald-700 shadow-lg transition hover:scale-105 active:scale-95"
